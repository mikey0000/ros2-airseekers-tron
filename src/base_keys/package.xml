<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base_keys</name>
  <version>0.1.0</version>
  <description>
    Airseekers Tron top-panel button driver (evdev) — publishes
    mower_interfaces/MowerBaseButtonInfo on /mower_base/button_info.
  </description>
  <maintainer email="michael@example.com">michael</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>mower_interfaces</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
