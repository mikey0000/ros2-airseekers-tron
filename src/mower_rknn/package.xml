<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_rknn</name>
  <version>0.1.0</version>
  <description>Shared RK3588S NPU (rknn-toolkit-lite2) inference + preprocessing helpers for
    the Airseekers Tron perception nodes (det_ros / seg_ros).</description>
  <maintainer email="michael@example.com">michael</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
