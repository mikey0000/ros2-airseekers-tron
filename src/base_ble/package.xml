<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base_ble</name>
  <version>0.1.0</version>
  <description>Bridge between the Airseekers Tron BLE module (/dev/serial_ble) and ROS 2.
    Parses the framed BLE protocol and dispatches drive/teleop/mapping/version commands.</description>
  <maintainer email="michael@example.com">michael</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>mower_proto</exec_depend>
  <exec_depend>mower_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
