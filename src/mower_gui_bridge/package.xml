<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_gui_bridge</name>
  <version>0.1.0</version>
  <description>
    Presents the Airseekers Tron hardware stack (mower_mcu_driver, um960_gps_driver,
    robot_localization) under the topic/service names and mowgli_interfaces types the
    MowgliNext web GUI expects, plus a stub high-level state machine (IDLE / RECORDING /
    MANUAL_MOWING / EMERGENCY) with the blade interlock, until a real mission node exists.
  </description>
  <maintainer email="michael@example.com">michael</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>mower_interfaces</depend>
  <depend>mowgli_interfaces</depend>
  <!-- optional at runtime: set_datum forwards to navsat_transform_node /datum when present -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
