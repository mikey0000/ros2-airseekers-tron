# Coverage plan request for mower_coverage (Fields2Cover headland + swath).
# All geometry is metric, in the frame given by frame_id (node default "map").
# Tuning knobs are per-request so a plan is self-describing; the node applies
# the defaults below when a field is left at its sentinel (<= 0 / < 0).

geometry_msgs/Polygon boundary            # outer field boundary, >= 3 points
geometry_msgs/Polygon[] holes             # interior holes to avoid (flower beds, ponds)
string     frame_id                       # frame of all geometry; empty -> "map"

geometry_msgs/Point start                 # optional mower start position
bool       has_start                      # false -> no transit from start
geometry_msgs/Point goal                  # optional mower goal position
bool       has_goal                       # false -> no transit to goal

float64 operation_width                   # swath spacing [m] (the "border width"); <= 0 -> 0.18
float64 headland_width                    # desired headland band [m]; <= 0 -> 0.20
int32   headland_passes                   # -1 = none, 0 = auto (ceil(headland_width/operation_width)), >0 = forced
float64 mow_angle_deg                     # swath heading [deg]; < 0 = auto (fewest swaths)
float64 min_swath_length                  # drop swaths shorter than this [m]; <= 0 -> 0.15
# Per-area mowing settings (defaults keep the pre-settings behaviour).
int32   headland_rings -1                 # perimeter laps: -1 = use headland_passes, 0 = none, >0 = exactly
string  path_mode "zigzag"                # zigzag | spiral | contour_only ("" = zigzag); cross /
                                          # alternate are mission-level (several zigzag plans)
bool    edge_first true                   # true: rings, then swaths; false: swaths, then rings
# Swath order and turns (defaults keep the pre-turn behaviour for old callers).
string  route_order "boustrophedon"       # boustrophedon | snake (0,2,4..5,3,1) | spiral | racetrack ("" = boustrophedon)
int32   route_spiral_size 6               # swaths per SpiralOrder block (>= 2)
float64 min_turn_radius_m -1.0            # < 0 = node param min_turn_radius_m; 0 = pivot in place
string  turn_type ""                      # auto (loop -> reverse-curve -> pivot) | loop | reverse | pivot ("" = auto)
float64 boundary_inset_m -1.0             # per-area edge margin (blade edge inside the line) [m]; < 0 = node param
---
bool   success
string message
nav_msgs/Path path                        # transit-in + headland rings + swaths + transit-out
float64 total_distance                    # [m], including transits
uint8 POSE_MOW=0                          # ring / swath / straight connector pose
uint8 POSE_TURN=1                         # forward turn pose (inside the area, blade on)
uint8 POSE_TURN_REVERSE=2                 # turn pose reached driving BACKWARDS
uint8[] pose_flags                        # parallel to path.poses (empty from old nodes)
uint32  ring_count
uint32  swath_count
float64 planning_time_s
# Coverage verification (swept op_width footprint vs. the area shrunk by
# boundary_inset_m, holes grown by the ring keep-out), after gap filling.
float64 coverage_fraction                 # covered / target area, [0, 1]
float64 coverage_fraction_before_fill     # same, before the fill passes
uint32  gap_count                         # uncovered pieces >= min_gap_area_m2
float64 gap_area_m2                       # total uncovered area (all pieces)
geometry_msgs/Polygon[] gaps              # uncovered pieces >= min_gap_area_m2
uint32  fill_swath_count                  # extra fill passes (included in swath_count)
