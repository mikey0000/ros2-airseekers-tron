<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>det_ros_cpp</name>
  <version>0.1.0</version>
  <description>C++ (RKNN C API) port of det_ros: YOLOv8 obstacle detection on the RK3588 NPU.
    Same node name, parameters (det_ros/config/det.yaml) and topics as the Python det_ros.</description>
  <maintainer email="michael@example.com">michael</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>det_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
