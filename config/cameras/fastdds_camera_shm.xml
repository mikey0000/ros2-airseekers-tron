<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for the camera PUBLISHERS (set via FASTRTPS_DEFAULT_PROFILES_FILE by
  launch/cameras.launch.py, scoped to the camera nodes only).

  Why: with the default 512 KiB shared-memory segment a 1080p bgr8 Image (6.2 MB) is
  fragmented and, being best-effort (sensor QoS), mostly lost: a synthetic 15 Hz 6.2 MB
  publisher was received at 5.66 Hz in the mower_humble container; with this profile on
  the publisher alone 14.95 Hz (2026-10-06, Fast DDS 2.6.12). In Fast DDS SHM the writer
  allocates the payload in its own segment, so subscribers need no profile.
  The host's net.core.rmem_max is 212992, so UDP (remote subscribers) stays lossy for raw
  images: remote viewers should use image_raw/compressed.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>camera_shm</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
      <maxMessageSize>16777216</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>camera_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="camera_large_data" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>camera_shm</transport_id>
        <transport_id>camera_udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
