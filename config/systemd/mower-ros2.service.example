[Unit]
Description=Airseekers Tron ROS 2 Humble bridge (Docker)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -f /home/airseekers/ros2_stack/docker/docker-compose.yml up -d mower_humble
ExecStop=/usr/bin/docker compose -f /home/airseekers/ros2_stack/docker/docker-compose.yml down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
