# ROS 2 Humble (Jammy userland) for the Airseekers mower (aarch64).
#
# Context (whole-repo):
# - ros2_port_handoff/09_platform/os-release.txt: device OS = Ubuntu 20.04.6 LTS (focal)
# - ros2_port_handoff/09_platform/uname.txt:      kernel 5.10.209, aarch64
# - ros2_port_handoff/09_platform/dpkg-l.txt + ros_noetic_debs.txt: stock ROS 1 Noetic stack
# - mower_docs/02-ros2-migration.md: Humble needs 22.04 (jammy) -> containerize, do not upgrade BSP
#
# This image runs a Jammy userland on top of the stock 20.04 kernel.
# No ros1_bridge here on purpose: bridging (Noetic<->Humble, custom mower_msgs)
# is a separate from-source build; see ../docs/deployment.md.

FROM --platform=linux/arm64 ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=humble

# Base build/colcon/serial tooling + requested Humble stacks.
# - ros-humble-ros-base: explicit even though ros-base image already contains it
# - nav2-bringup: Nav2 bringup/launch (replaces Noetic move_base/navfn per migration doc)
# - control-toolbox: replaces ros-noetic-control-toolbox usage
# - serial: pyserial + asio serial driver (Humble name is serial-driver, not "serial")
# - colcon: workspace builds
# - foxglove-bridge: optional, guarded (may be absent from some arm64 snapshots)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-ros-base \
      ros-humble-nav2-bringup \
      ros-humble-control-toolbox \
      ros-humble-serial-driver \
      python3-colcon-common-extensions \
      python3-rosdep \
      python3-vcstool \
      python3-serial \
      libserial-dev \
      build-essential \
      cmake \
      git \
      usbutils \
      iproute2 \
      iputils-ping \
    && (apt-get install -y --no-install-recommends ros-humble-foxglove-bridge \
        || echo "NOTE: ros-humble-foxglove-bridge not in this snapshot, skipping") \
    && rm -rf /var/lib/apt/lists/*

# rosdep (guarded: rebuild cache is refreshed at build time, not on device)
RUN (rosdep init || true) && rosdep update || true

WORKDIR /work

# Workspace is mounted at runtime (compose binds ../src -> /work/src),
# so only ensure the mount points exist at build time.
RUN mkdir -p /work/src /work/launch /work/config

# Convenience: interactive shells source Humble + workspace overlay if built.
RUN echo 'source /opt/ros/humble/setup.bash 2>/dev/null || true; \
[ -f /work/install/setup.bash ] && source /work/install/setup.bash || true' >> /root/.bashrc

CMD ["bash"]
