[0m$ [0mcat >> /tmp/opencode/f2c_probe/probe3.cpp << 'EOF'
// Probe 3: headland rings on a holed field.
#include <fields2cover.h>
#include <cstdio>

int main() {
  f2c::types::LinearRing ext;
  ext.addPoint(0, 0); ext.addPoint(3, 0); ext.addPoint(3, 3);
  ext.addPoint(0, 3); ext.addPoint(0, 0);
  f2c::types::LinearRing hole;
  hole.addPoint(1, 1); hole.addPoint(2, 1); hole.addPoint(2, 2);
  hole.addPoint(1, 2); hole.addPoint(1, 1);
  f2c::types::Cell holed(ext);
  holed.addRing(hole);
  f2c::types::Cells cells;
  cells.addGeometry(holed);
  f2c::hg::ConstHL hl;
  auto safe = hl.generateHeadlands(cells, -0.25);
  auto passes = hl.generateHeadlandSwaths(safe, 0.5, 1, true);
  printf("holed: %zu passes\n", passes.size());
  for (size_t i = 0; i < passes.size(); ++i) {
    printf("pass %zu: %zu cells\n", i, passes[i].size());
    for (size_t c = 0; c < passes[i].size(); ++c) {
      auto r = passes[i].getGeometry(c).getGeometry(0);
      printf("  cell %zu ring (%zu pts):", c, r.size());
      for (size_t j = 0; j < r.size(); ++j) {
        auto p = r.getGeometry(j);
        printf(" (%.3f,%.3f)", p.getX(), p.getY());
      }
      printf("\n");
    }
  }
  // mainland hole size
  auto mainland = hl.generateHeadlands(safe, 0.5);
  printf("mainland: %zu cells\n", mainland.size());
  for (size_t i = 0; i < mainland.size(); ++i) {
    const auto& c = mainland.getGeometry(i);
    printf("  cell %zu: %zu rings\n", i, c.size());
    for (size_t r = 0; r < c.size(); ++r) {
      auto ring = c.getGeometry(r);
      printf("    ring %zu (%zu pts):", r, ring.size());
      for (size_t j = 0; j < ring.size(); ++j) {
        auto p = ring.getGeometry(j);
        printf(" (%.3f,%.3f)", p.getX(), p.getY());
      }
      printf("\n");
    }
  }
  return 0;
}
EOF
