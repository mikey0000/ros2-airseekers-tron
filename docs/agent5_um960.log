[Unit]
Description=mower base 
After=network.target dev-ttyUSB2.device rosmaster.service systemd-udev-trigger.service logrotate.service mower-bluetooth.service
Wants=rosmaster.service

[Service]
User=root
Type=simple
ExecStart=/bin/bash -c "source /workspace/profile/mower.sh;roslaunch --wait  mower mower_base.launch"
Restart=always
StandardOutput=append:/userdata/log/base.log
StandardError=append:/userdata/log/base.log
Restart=always
RestartSec=3
Nice=-5
CPUWeight=200

[Install]
WantedBy=multi-user.target---
<launch>
  <!-- 底盘控制驱动，包括了所有的静态tf变换 -->
  <arg name="environment" default="$(optenv ENVIRONMENT default)"/>
  <arg name="simulation" default="$(eval arg('environment') == 'simulation')"  />
  <group if="$(arg simulation)">
    <param name="robot_description" command="$(find xacro)/xacro $(find mower_base)/urdf/mower.urdf"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen">
        <param name="publish_frequency" type="double" value="1.0"/>
    </node>
    <node name="fake_mower" pkg="mower_simulation" type="fake_mower_node" output="screen" />
  </group>

  <group unless="$(arg simulation)">
    <include file="$(find mower_base)/launch/mower_base.launch" />
    <include file="$(find base_rtk)/launch/base_rtk.launch" />
    <include file="$(find base_cameras)/launch/base_cameras.launch" />
  </group>

  <include file="$(find base_ble)/launch/base_ble.launch" />
</launch>
