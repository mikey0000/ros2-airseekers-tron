bool BDS_B2_used_in_solution
bool BDS_B3_used_in_solution

==> msg/UnicoreMessageHeader.msg <==
# Unicore Message Header
# 1 Sync
#   字段类型: Char
#   描述: 同步字符，ASCII 信息始终以一个“#”字符开始
#
#2 Message
#   字段类型: Char
#   描述: 本手册中 log 或命令的 ASCII 名称
#
#3 CPUIDle
#   字段类型: Uchar
#   描述: 处理器空闲时间的最小百分比，每秒计算 1 次。
#
#4 TimeRef
#   字段类型: Uchar
#   描述: 接收机工作的时间系统(GPST or BDST)
#
#5 TimeStatus
#   字段类型: Uchar
#   描述: GPS 时间质量。当前取值 Unknown 或 Fine，前者表明接收机还未能计算出准确的 GPS 时间。
#
#6 Wn
#   字段类型: Ushort
#   描述: GPS 周数
#
#7 Ms
#   字段类型: ulong
#   描述: GPS 周内秒，精确到 ms。
#
#8 reserved
#   字段类型: ulong
#   描述: 保留
#
#9 version
#   字段类型: uchar
#   描述: Unicore 格式版本号保留字段。
#
#10 Leap sec
#    字段类型: uchar
#    描述: 闰秒
#
#11 Output Delay
#    字段类型: Ushort
#    描述: 数据输出时间延迟(数据输出与 GNSS 卫星信号采样时间差)，单位: ms

string message_name
string cpu_idle
string time_ref
string time_status
uint16 gps_week_num
uint32 gps_seconds
uint32 reserved
uint8 version
uint8 leap_seconds
uint16 output_delay # ms

==> msg/UnicoreNav.msg <==
# Unicore BestNav Message
# 表 7-82 BESTNAV 数据结构
#
# 字段               数据描述                                        类型       字节数  字节偏移
# -------------------------------------------------------------------------------------------------
# BESTNAV header    消息头，二进制消息头结构请参考 表 7-48，         H          -        0
#                   ASCII 消息头结构请参考 表 7-49
# p-sol status      解状态，参考表 0-5 解的状态                        Enum       4        H
# pos type          位置类型(参考表 0-4 位置或速度类型)                Enum       4        H+4
# lat               纬度，deg                                         Double     8        H+8
# lon               经度，deg                                         Double     8        H+16
# hgt               海拔高，m                                         Double     8        H+24
# lat σ             纬度标准差，m                                     Float      4        H+40
# lon σ             经度标准差，m                                     Float      4        H+44
# hgt σ             高度标准差，m                                     Float      4        H+48
# stn id            基站 ID，缺省值为 0                                Char[4]    4        H+52
# diff_age          差分龄期，s                                        Float      4        H+56
# sol_age           解的龄期，s                                        Float      4        H+60
# #SVs              跟踪的卫星数                                       Uchar      1        H+64
# #solnSVs          在解中使用的卫星数                                 Uchar      1        H+65
# Reserved          保留                                              Uchar      1        H+66
# Reserved          保留                                              Uchar      1        H+67
# Reserved          保留                                              Uchar      1        H+68
# undulation        大地水准面差距-大地水准面和 WGS84 椭球面之间的距离(米)  Float      4        H+32
# datum id#         坐标系 ID 号，当前仅支持 WGS84 (二进制为 61)       Enum       4        H+36
# ext sol stat      扩展解的状态，参考表 7-85 扩展解状态                Hex        1        H+69
# Galileo&BDS3 sig mask Galileo 和 BDS3 使用的信号掩码，参考表 7-84 Galileo&BDS3 使用的信号掩码 Hex 1        H+70
# GPS, GLONASS and BDS2 sig mask GPS, GLONASS 和 BDS2 使用的信号掩码，参考表 7-83 GPS/GLONASS/BDS2 使用的信号掩码 Hex 1        H+71
# V-sol status      解状态，参考表 0-5 解的状态                        Enum       4        H+72
# vel type          速度类型(参考表 0-4 位置或速度类型)                Enum       4        H+76
# age               差分龄期，s                                        Float      4        H+84
# hor spd           对地水平速度，m/s                                  Double     8        H+88
# latency           根据速度时标计算的延迟值，以秒为单位。用历元时间减去延迟可得到更准确的速度结果。  Float  4        H+80
# trk gnd           相对于真北的实际对地运动方向 (相对地面轨迹)，deg     Double     8        H+96
# vert spd          垂直速度，m/s，正值表示高度增加(向上)，负值表示高度下降(向下) Double 8        H+104
# Verspd std        高程速度标准差，单位 m/s                            Float      4        H+112
# Horspd std        水平速度标准差，单位 m/s                            Float      4        H+116
# xxxx              32 位 CRC 校验(仅 ASCII 和二进制)                  Hex        4        H+120
# [CR][LF]          语句结束符(仅 ASCII)                               -          -        -

Header header

UnicoreMessageHeader unicore_msg_header

uint32 SOL_COMPUTED = 0       # 位置解算成功
uint32 INSUFFICIENT_OBS = 1   # 观测数据不足
uint32 NO_CONVERGENCE = 2     # 未收敛, 输出解无效
uint32 COV_TRACE = 3          # 协方差矩阵的trace太大（ > 1000）
string position_solution_status
string velocity_solution_status

uint32 NONE = 0               # 无效解
uint32 FIXEDPOS = 1           # 固定解
uint32 FIXEDHEIGHT = 2        # 不支持
uint32 DOPPLER_VELOCITY = 3   # 多普勒速度
uint32 SINGLE = 4             # 单点定位
uint32 PSRDIFF = 5            # 伪距差分
uint32 SBAS = 6               # SBAS定位
uint32 L1_FLOAT = 7           # L1浮点解
uint32 IONOFREE_FLOAT = 8     # 无电离层浮点解
