# RTK模组的输入端口号，用于获取RTK模块输出的GPGGA数据，以及输入来自ntrip服务器的RTCM数据
# 实际使用的时候，需要绑定设备的端口号，再做一个软链，例如/dev/rtk_input --> /dev/ttyUSB0
rtk_input_port: "/dev/serial_rtk"
baud: 921600---SERIALCFG---
#!/usr/bin/env python3

import serial

if __name__ == '__main__':
    baud = 921600
    port = "/dev/serial_rtk"
    
    try:
        # 重置
        rtk_input = serial.Serial(port, baud, timeout=0.1)
        rtk_input.write(b'freset\r\n')
        rtk_input.close()

        # 写入配置
        rtk_input = serial.Serial(port, 115200, timeout=0.1)
        rtk_input.readline() # 阻塞等待初始化成功
        rtk_input.write(b'MODE ROVER\r\n')
        rtk_input.write(b'CONFIG RTK TIMEOUT 20 RELIABILITY 4\r\n')
        rtk_input.write(b'CONFIG DGPS TIMEOUT 12\r\n')
        rtk_input.write(b'GPGGA com1 0.2\r\n')
        rtk_input.write(b'GPRMC com1 0.2\r\n')
        rtk_input.write(b'GPVTG com1 0.2\r\n')
        rtk_input.write(b'GPHPR com1 0.2\r\n')
        # bestnav后续会作为主力数据格式进行融合定位
        # 每包数据大概200字节，10hz 波特率至少2000*8=16000, 
        # 115200波特率下，每秒最多接收115200/2000=57包数据
        rtk_input.write(b'BESTNAVA 5 \r\n') 
        # rtk_input.write(b'SATELLITEA 4\r\n')
        # rtk_input.write(b'BESTSATA 4\r\n')
        # rtk_input.write(b'config com1 115200\r\n')
        rtk_input.write(b'saveconfig\r\n')
        rtk_input.flush()

    except serial.SerialException as e:
        print(f"Error opening serial port: {e}")
    finally:
        # 确保串口连接被关闭
        if 'rtk_input' in locals() and rtk_input.is_open:
            rtk_input.close()
