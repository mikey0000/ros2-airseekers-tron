stream += cs("GNGSA,A,3,01,03,05,11,17,,,,,,,,2.10,1.05,2.33").encode()
stream += cs("GPGSV,3,1,21,01,40,083,44,03,17,313,40").encode()
stream += cs("GNSTA,3,FINE").encode()
