# Bit  掩码   描述
# 0    0x01   使用 GALILEO E1 计算
# 1    0x02   使用 GALILEO E5B 计算
# 2    0x04   使用 GALILEO E5A 计算
# 3    0x08   Reserved
# 4    0x10   使用 BDS3 B1I 计算
# 5    0x20   使用 BDS3 B3I 计算
# 6    0x40   使用 BDS3 B2a 计算
# 7    0x80   使用 BDS3 B1C 计算
uint32 GALILEO_BDS3_mask
bool GALILEO_E1_used_in_solution
bool GALILEO_E5B_used_in_solution
bool GALILEO_E5A_used_in_solution
bool BDS3_B1I_used_in_solution
bool BDS3_B3I_used_in_solution
bool BDS3_B2a_used_in_solution
bool BDS3_B1C_used_in_solution


