#!/bin/bash

# 检查文件是否存在
if [ ! -f "rtk_data.cap" ]; then
    echo "文件 rtk_data.cap 未找到"
    exit 1
fi

# 读取文件内容
data_to_send=$(cat rtk_data.cap)

# 写入数据到虚拟串口
while true; do
    echo -ne "$data_to_send" > /dev/serial_rtk_fake
    echo "已发送数据: $data_to_send"
    sleep .1  # 每秒写入一次
done
sudo socat -d -d PTY,link=/dev/serial_rtk,mode=666 PTY,link=/dev/serial_rtk_fake,mode=666
