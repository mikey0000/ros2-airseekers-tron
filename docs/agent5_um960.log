fix = n.fix_pub.msgs[-1]
print("[float RTK] status=%d vel=%.3f status_str=%s" % (fix.status.status, n.vel_pub.msgs[-1].twist.linear.x,
      n.status_pub.msgs[-1].data))

# no fix at all -> /fix must stay empty but /fix_status still published
n = run(cs("GNGGA,101530.00,,,,,0,00,99.9,,,,,,"))
print("[no fix] fix_msgs=%d status_msgs=%d status=%s" % (len(n.fix_pub.msgs), len(n.status_pub.msgs),
      n.status_pub.msgs[-1].data))
