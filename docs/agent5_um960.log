def mk(name, **attrs):
    m = types.ModuleType(name)
    for k,v in attrs.items(): setattr(m,k,v)
    sys.modules[name]=m

class Header:
    def __init__(self): self.stamp=None; self.frame_id=""
class NavSatStatus:
    STATUS_NO_FIX=-1; STATUS_FIX=0; STATUS_DGPS_FIX=1
    SERVICE_GPS=1; SERVICE_GLONASS=2; SERVICE_COMPASS=4; SERVICE_GALILEO=8
    def __init__(self): self.status=0; self.service=0
class NavSatFix:
    COVARIANCE_TYPE_UNKNOWN=0; COVARIANCE_TYPE_DIAGONAL_KNOWN=3
    def __init__(self):
        self.header=Header(); self.status=NavSatStatus()
        self.latitude=0.0; self.longitude=0.0; self.altitude=0.0
        self.position_covariance=[0.0]*9; self.position_covariance_type=0
mk('sensor_msgs'); mk('sensor_msgs.msg', NavSatFix=NavSatFix, NavSatStatus=NavSatStatus)
class String:
    def __init__(self, data=""): self.data=data
class Float32:
    def __init__(self, data=0.0): self.data=data
mk('std_msgs'); mk('std_msgs.msg', String=String, Float32=Float32)
class TwistStamped:
    def __init__(self):
        self.header=Header()
        self.twist=types.SimpleNamespace(linear=types.SimpleNamespace(x=0.0,y=0.0,z=0.0),
                                         angular=types.SimpleNamespace(x=0.0,y=0.0,z=0.0))
mk('geometry_msgs'); mk('geometry_msgs.msg', TwistStamped=TwistStamped)

class Pub:
    def __init__(self): self.msgs=[]
    def publish(self,m): self.msgs.append(m)
class Node:
    def __init__(self,name):
        self._params={}; self.pubs={}
    def declare_parameter(self,n,v): self._params[n]=v
    def get_parameter(self,n): return types.SimpleNamespace(value=self._params[n])
    def create_publisher(self,t,n,q=None): p=Pub(); self.pubs[n]=p; return p
    def create_timer(self,i,cb): return cb
    def get_clock(self): return types.SimpleNamespace(now=lambda: types.SimpleNamespace(to_msg=lambda: 42))
    def get_logger(self):
        l=types.SimpleNamespace()
        for m in ("info","warn","error","debug"): setattr(l,m,lambda *a,**k: None)
        return l
    def destroy_node(self): return True
mk('rclpy', init=None, ok=lambda: True, spin=None, shutdown=None)
mk('rclpy.node', Node=Node)
mk('rclpy.qos', HistoryPolicy=types.SimpleNamespace(KEEP_LAST=1),
   ReliabilityPolicy=types.SimpleNamespace(RELIABLE=1), QoSProfile=lambda **k: k)

from um960_gps_driver.um960_node import Um960Node
import um960_gps_driver.parsers as P

def cs(body):
    c=0
    for ch in body: c^=ord(ch)
    return ("$%s*%02X\r\n" % (body,c)).encode()

def bestnav_binary(pos_type=12, lat=48.1173, lon=11.5166666, speed=1.234, track=87.6):
    payload = bytearray(124)
    struct.pack_into("<II", payload, 0, 0, pos_type)
    struct.pack_into("<q", payload, 8, int(lat*1e8))
    struct.pack_into("<q", payload, 16, int(lon*1e8))
    struct.pack_into("<i", payload, 24, int(545.4*1e4))
    struct.pack_into("<fff", payload, 28, 0.005,0.007,0.012)
    payload[40:44]=b"BAS1"
    struct.pack_into("<ff", payload, 44, 0.5, 0.1)
    payload[52]=21; payload[53]=18
    struct.pack_into("<II", payload, 68, 0, 3)
    struct.pack_into("<d", payload, 88, speed)
    struct.pack_into("<d", payload, 96, track)
    struct.pack_into("<d", payload, 104, -0.015)
    body = bytes([0x0A]) + struct.pack("<H", 124) + bytes(payload)
    return b"\xaa\x44\xb5" + body + struct.pack("<H", P.crc16_xmodem(body))

def run(stream, chunk=None):
    n = Um960Node()
    if chunk:
        for i in range(0,len(stream),chunk): n._consume(stream[i:i+chunk])
    else:
        n._consume(stream)
    n._publish_tick()
    return n

stream  = cs("GNGGA,101530.00,4807.038,N,01131.000,E,4,21,0.6,545.4,M,46.9,M,0.5,0451")
stream += cs("GNRMC,101530.00,A,4807.038,N,01131.000,E,2.4,87.6,051026,,,A")
stream += cs("GNVTG,87.6,T,90.0,M,2.4,N,4.4,K,A")
stream += cs("GNGSA,A,3,01,03,05,11,17,,,,,,,,2.10,1.05,2.33")
stream += cs("GPGSV,3,1,21,01,40,083,44,03,17,313,40")
stream += cs("GNSTA,3,FINE")
stream += cs("GNVER,UM960,HN1.10,VER1.20")
stream += bestnav_binary()

for label, ch in (("single read", None), ("3-byte chunks", 3)):
    n = run(stream, ch)
    fix = n.fix_pub.msgs[-1]
    print("[%s] fix=%.7f,%.7f alt=%.2f status=%d cov=%d" % (label, fix.latitude, fix.longitude,
          fix.altitude, fix.status.status, fix.position_covariance_type))
    print("   vel=%.3f heading=%.1f" % (n.vel_pub.msgs[-1].twist.linear.x, n.heading_pub.msgs[-1].data))
