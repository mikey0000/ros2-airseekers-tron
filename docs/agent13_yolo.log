# ROS 2 Humble (Jammy userland) for the Airseekers mower (aarch64).
#
# Context (whole-repo):
# - ros2_port_handoff/09_platform/os-release.txt: device OS = Ubuntu 20.04.6 LTS (focal)
# - ros2_port_handoff/09_platform/uname.txt:      kernel 5.10.209, aarch64
# - ros2_port_handoff/09_platform/dpkg-l.txt + ros_noetic_debs.txt: stock ROS 1 Noetic stack
# - mower_docs/02-ros2-migration.md: Humble needs 22.04 (jammy) -> containerize, do not upgrade BSP
#
# This image runs a Jammy userland on top of the stock 20.04 kernel.
# No ros1_bridge here on purpose: bridging (Noetic<->Humble, custom mower_msgs)
# is a separate from-source build; see ../docs/deployment.md.

FROM --platform=linux/arm64 ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=humble

# Base build/colcon/serial tooling + requested Humble stacks.
# - ros-humble-ros-base: explicit even though ros-base image already contains it
# - nav2-bringup: Nav2 bringup/launch (replaces Noetic move_base/navfn per migration doc)
# - control-toolbox: replaces ros-noetic-control-toolbox usage
# - serial: pyserial + asio serial driver (Humble name is serial-driver, not "serial")
# - colcon: workspace builds
# - foxglove-bridge: optional, guarded (may be absent from some arm64 snapshots)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-ros-base \
      ros-humble-nav2-bringup \
      ros-humble-control-toolbox \
      ros-humble-serial-driver \
      python3-colcon-common-extensions \
      python3-rosdep \
      python3-vcstool \
      python3-serial \
      libserial-dev \
      build-essential \
      cmake \
      git \
      usbutils \
      iproute2 \
      iputils-ping \
    && (apt-get install -y --no-install-recommends ros-humble-foxglove-bridge \
        || echo "NOTE: ros-humble-foxglove-bridge not in this snapshot, skipping") \
    && rm -rf /var/lib/apt/lists/*

# rosdep (guarded: rebuild cache is refreshed at build time, not on device)
RUN (rosdep init || true) && rosdep update || true

WORKDIR /work

# Workspace is mounted at runtime (compose binds ../src -> /work/src),
# so only ensure the mount points exist at build time.
RUN mkdir -p /work/src /work/launch /work/config

# Convenience: interactive shells source Humble + workspace overlay if built.
RUN echo 'source /opt/ros/humble/setup.bash 2>/dev/null || true; \
[ -f /work/install/setup.bash ] && source /work/install/setup.bash || true' >> /root/.bashrc

CMD ["bash"]
==== compose
# Compose for the mower's Humble container.
# Run from ros2_stack/:  docker compose -f docker/docker-compose.yml <up|build|run ...>
# Serial map source: ros2_port_handoff/09_platform/dev_nodes.txt + udev-symlinks.txt
#   serial_mower->ttyS9 (mower MCU, raw 115200) | serial_imu->ttyS1 | serial_rtk->ttyS4
#   serial_ble->ttyS3 | serial_lte->ttyUSB2 (Quectel EC200A) | ttyUSB0/1 (modem/GNSS AT ports)
#   cameras: video44/53/62 (left_oa_camera / right_oa_camera / rear_camera)

services:
  mower_humble:
    build:
      context: ..
      dockerfile: docker/Dockerfile.humble
      network: host
    image: mower:humble
    container_name: mower_humble
    platform: linux/arm64
    privileged: true            # needs raw /dev + serial/ioctl access on the BSP kernel
    network_mode: host          # ROS 2 DDS discovery + Foxglove on LAN without port lists
    ipc: host
    stdin_open: true
    tty: true
    environment:
      - ROS_DISTRO=humble
      - ROS_DOMAIN_ID=0
      - RMW_IMPLEMENTATION=rmw_fastrtps_cpp
      - DISPLAY=${DISPLAY:-}
    volumes:
      # ROS 2 workspace sources (bind-mount; built inside container by scripts/build.sh)
      - ..:/work
      # Full /dev bind covers udev symlinks + hotplug (ttyUSB*, video*); explicit
      # `devices:` below pins the load-bearing serial ports even if /dev churns.
      - /dev:/dev
      - /tmp/.X11-unix:/tmp/.X11-unix:rw
    devices:
      - /dev/ttyS9:/dev/ttyS9     # serial_mower (mower MCU)
      - /dev/ttyS1:/dev/ttyS1     # serial_imu
      - /dev/ttyS4:/dev/ttyS4     # serial_rtk
      - /dev/ttyS3:/dev/ttyS3     # serial_ble
      - /dev/ttyUSB0:/dev/ttyUSB0
      - /dev/ttyUSB1:/dev/ttyUSB1
      - /dev/ttyUSB2:/dev/ttyUSB2 # serial_lte (Quectel)
    command: bash
==== launch bringup
"""Top-level bringup for the Airseekers Tron ROS 2 (Humble) driver stack.

Starts the three hardware drivers. Planner/task nodes (MowgliNext-derived)
are layered on top once routing/docking nodes land.
"""
from launch import LaunchDescription
from launch_ros.actions import Node


def generate_launch_description():
    return LaunchDescription([
        Node(
            package='mower_mcu_driver',
            executable='mcu_node',
            name='mower_mcu_driver',
            parameters=[{
                'port': '/dev/serial_mower',
                'baud': 115200,
                'cmd_vel_timeout': 0.5,
            }],
            output='screen',
        ),
        Node(
            package='wit_imu_driver',
            executable='wit_node',
            name='wit_imu_driver',
            parameters=[{
                'port': '/dev/serial_imu',
                'rate': 100.0,
                'frame_id': 'imu_link',
            }],
            output='screen',
        ),
        Node(
            package='um960_gps_driver',
            executable='um960_node',
            name='um960_gps_driver',
            parameters=[{
                'port': '/dev/serial_rtk',
                'baud': 115200,
                'frame_id': 'gps',
            }],
            output='screen',
        ),
    ])
