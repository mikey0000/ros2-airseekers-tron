#!/usr/bin/env python3
"""Keep the base_cameras USB/MIPI cameras capturing while someone is watching.

The vendor /rear_camera node owns /dev/{left_oa,right_oa,rear}_camera and only
captures after <cam>/start_capture is called; the behaviour tree calls
stop_capture after docking/undocking. This node watches who subscribes to each
<cam>/image_raw and, if a viewer (web_video_server) is subscribed but no frames
are arriving, calls start_capture. It never calls stop_capture, so it can't
interfere with the vendor's own use of the cameras.

Env:
  CAM_KEEPER_CAMERAS   comma list (default left_oa_camera,right_oa_camera,rear_camera)
  CAM_KEEPER_ALWAYS_ON 1 = keep capturing even with no viewer (default 0)
"""
import os
import rosgraph
import rospy
from sensor_msgs.msg import CameraInfo
from std_srvs.srv import Empty

CAMERAS = [c.strip() for c in os.environ.get(
    'CAM_KEEPER_CAMERAS', 'left_oa_camera,right_oa_camera,rear_camera').split(',') if c.strip()]
ALWAYS_ON = os.environ.get('CAM_KEEPER_ALWAYS_ON', '0') == '1'
VIEWERS = ('/web_video_server',)
STALE_S = 3.0
RETRY_S = 5.0

last_frame = {c: 0.0 for c in CAMERAS}
last_start = {c: 0.0 for c in CAMERAS}


def on_info(cam):
    # camera_info is published alongside every frame and is tiny, so it is a
    # cheap liveness signal compared to subscribing to 1080p image_raw.
    def cb(_msg):
        last_frame[cam] = rospy.get_time()
    return cb


def watched_cameras(master):
    _, subs, _ = master.getSystemState()
    subs = dict(subs)
    out = set()
    for cam in CAMERAS:
        for topic, nodes in subs.items():
            if topic.startswith('/%s/image' % cam) and any(n in VIEWERS for n in nodes):
                out.add(cam)
    return out


def main():
    rospy.init_node('mower_cam_keeper')
    master = rosgraph.Master(rospy.get_name())
    for cam in CAMERAS:
        rospy.Subscriber('/%s/camera_info' % cam, CameraInfo, on_info(cam), queue_size=1)
    rospy.loginfo('cam keeper: cameras=%s always_on=%s', CAMERAS, ALWAYS_ON)

    rate = rospy.Rate(1)
    while not rospy.is_shutdown():
        try:
            wanted = set(CAMERAS) if ALWAYS_ON else watched_cameras(master)
        except Exception as e:  # master restarting
            rospy.logwarn_throttle(30, 'cam keeper: master query failed: %s' % e)
            wanted = set()
        now = rospy.get_time()
        for cam in wanted:
            if now - last_frame[cam] > STALE_S and now - last_start[cam] > RETRY_S:
                last_start[cam] = now
                try:
                    srv = '/%s/start_capture' % cam
                    rospy.wait_for_service(srv, timeout=2)
                    rospy.ServiceProxy(srv, Empty)()
                    rospy.loginfo('cam keeper: started %s', cam)
                except Exception as e:
                    rospy.logwarn('cam keeper: start_capture %s failed: %s', cam, e)
        rate.sleep()


if __name__ == '__main__':
    main()
