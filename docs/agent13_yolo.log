cd ros2_port_handoff/01_mcu_protocol/mower_base_pkg/mower_sdk
clang++ -std=c++17 -Wall -Wextra -Iinclude -c src/*.cpp
# full library + ROS node build comes once the node sources (tasks 1–3) land; see mower_base_pkg/CMakeLists.txt
```
