		logrus.Errorf("RosProvider: subscribe %s (%s): %v", def.ROS2Topic, key, err)
		return
	}
	r.foxgloveSubscribed[key] = true
	logrus.Infof("RosProvider: subscribed to %s as '%s'", def.ROS2Topic, key)
}

