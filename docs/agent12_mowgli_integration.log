	"imu":        80,
	"lidar":      80,
	"pose":       80,
	"fusionRaw":  80,
	"wheelOdom":  80,
	"ticks":      80,
	"gps":        80,
	"gnssStatus": 80,
	"cogHeading": 150,
	"magYaw":     150,
}

