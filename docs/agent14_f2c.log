#include "polygon_coverage_planners/cost_functions/path_cost_functions.h"
#include "polygon_coverage_planners/graphs/sweep_plan_graph.h"
#include "polygon_coverage_planners/sensor_models/sensor_model_base.h"


#include <polygon_coverage_msgs/PolygonWithHolesStamped.h>
#include "polygon_coverage_planners/planners/polygon_stripmap_planner.h"

#include "simplify.h"

using namespace std;
using namespace polygon_coverage_planning;

namespace planning
{

// 覆盖规划
struct CoverData
{   
    // 输入的轮廓边界
    geometry_msgs::Polygon hull;
    std::vector<geometry_msgs::Polygon> holes;
    // 第一次简化后的轮廓边界
    geometry_msgs::Polygon simplified_hull;
    std::vector<geometry_msgs::Polygon> simplified_holes;
    
    // CGAL输入的原始轮廓边界
    PolygonWithHoles polygon_with_holes;
    // CGAL输入的简化后的轮廓边界
    //std::vector<Point_2>  solution; // 覆盖路径
};

class cover 
{
public:
    cover(const ros::NodeHandle& nh);
    ~cover();

    bool SetPolygonWithHoles(const polygon_coverage_msgs::PolygonWithHolesStamped& polygon_with_holes);
    bool PlanPath(const geometry_msgs::PoseStamped& start_pose, 
                  const geometry_msgs::PoseStamped& goal_pose,
                  trajectory_msgs::MultiDOFJointTrajectory& sampled_plan);   


    // 原始孔洞进行预处理
    CoverData PreprocessPolygon(const geometry_msgs::Polygon &hull,const std::vector<geometry_msgs::Polygon> &holes);
    bool CoverPlan(const PolygonWithHoles &cover_polygon, nav_msgs::Path &cover);

    void Init(const PolygonWithHoles &cover_polygon);

    bool CoverPlan(const PolygonWithHoles &cover_polygon);

public:
    // 数据类型转化
    polygon_coverage_msgs::PolygonWithHolesStamped FromData(const PolygonWithHoles &polygon);
    void convertPolygonToMsg(const Polygon_2& polygon, geometry_msgs::Polygon& msg);

    // From
    nav_msgs::Path FromData(const trajectory_msgs::MultiDOFJointTrajectory& sampled_plan);
    
    // Too PolygonWithHoles
    PolygonWithHoles ToPolygonWithHoles(const geometry_msgs::Polygon &hull,const std::vector<geometry_msgs::Polygon> &holes);
    bool polygonFromMsg(const polygon_coverage_msgs::PolygonWithHolesStamped& msg,PolygonWithHoles &polygon, double &altitude,std::string &frame);
    void SanitizeVertices(Polygon_2& poly);

    void UpdateSensorModel();

private:
     
    ros::NodeHandle nh_;  
    // polygon coverage：设置轮廓
    ros::ServiceClient polygon_client_;
    // polygon coverage：设置起点和终点，开始规划
    ros::ServiceClient planner_client_;

private:

  // The solution waypoints for a given start and goal.
  std::vector<Point_2> solution_;

  // Parameters
  bool offset_polygons_;
  bool sweep_single_direction_;
  std::optional<double> lateral_footprint_;
  std::optional<double> lateral_overlap_;
  std::optional<double> lateral_fov_;

  double wall_distance_;

  std::pair<PathCostFunction, CostFunctionType> path_cost_function_;

  // The library object that actually does planning.
  SensorModelType sensor_model_type_;
  DecompositionType decomposition_type_;
  std::vector<Polygon_2> decomposition_;

  std::shared_ptr<SensorModelBase> sensor_model_;

private:
  double min_area_;
  std::shared_ptr<Simplifier> simplifier_;
  
  //sweep_plan_graph::SweepPlanGraph sweep_plan_graph_;
  sweep_plan_graph::SweepPlanGraph::Settings settings_;
  std::shared_ptr<PolygonStripmapPlanner> m_PolygonPlanner_;

};


}// namespace fusion
