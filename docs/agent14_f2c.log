  2131	  f2c::types::LinearRing out;
  2132	  for (int i = 0; i < ext->getNumPoints(); ++i)
  2133	  {
  2134	    out.addPoint(f2c::types::Point(ext->getX(i), ext->getY(i)));
  2135	  }
  2136	  return out;
  2137	}
