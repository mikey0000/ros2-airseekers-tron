  1958	// ── Boundary geometry (used by coverage_server's in-bounds verification) ─────
  1959	
  1960	bool pointInRing(double x, double y, const std::vector<std::pair<double, double>>& ring)
  1961	{
  1962	  const std::size_t n = ring.size();
  1963	  if (n < 3)
  1964	  {
  1965	    return false;
  1966	  }
  1967	  bool inside = false;
  1968	  for (std::size_t i = 0, j = n - 1; i < n; j = i++)
  1969	  {
  1970	    const double xi = ring[i].first, yi = ring[i].second;
  1971	    const double xj = ring[j].first, yj = ring[j].second;
  1972	    const bool crosses = ((yi > y) != (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
  1973	    if (crosses)
  1974	    {
  1975	      inside = !inside;
  1976	    }
  1977	  }
  1978	  return inside;
  1979	}
  1980	
  1981	double distanceToRing(double x, double y, const std::vector<std::pair<double, double>>& ring)
  1982	{
  1983	  const std::size_t n = ring.size();
  1984	  if (n < 2)
  1985	  {
  1986	    return std::numeric_limits<double>::max();
  1987	  }
  1988	  double best = std::numeric_limits<double>::max();
  1989	  for (std::size_t i = 0, j = n - 1; i < n; j = i++)
  1990	  {
  1991	    const double ax = ring[j].first, ay = ring[j].second;
  1992	    const double bx = ring[i].first, by = ring[i].second;
  1993	    const double dx = bx - ax, dy = by - ay;
  1994	    const double len2 = dx * dx + dy * dy;
  1995	    double t = (len2 > 0.0) ? ((x - ax) * dx + (y - ay) * dy) / len2 : 0.0;
  1996	    t = std::max(0.0, std::min(1.0, t));
  1997	    const double px = ax + t * dx, py = ay + t * dy;
  1998	    best = std::min(best, std::hypot(x - px, y - py));
  1999	  }
  2000	  return best;
  2001	}
  2002	
  2003	f2c::types::LinearRing bufferRingOutward(const f2c::types::LinearRing& in, double margin)
  2004	{
  2005	  if (margin < 1e-3 || in.size() < 3)
  2006	  {
  2007	    return dedupClosedRing(in);
  2008	  }
  2009	  // Grow the ring's polygon outward with GDAL/OGR (F2C's own geometry
  2010	  // backend): drawn map obstacles get an operator-tunable safety margin
  2011	  // (obstacle_margin) so the planner keeps swaths, connectors and headlands
  2012	  // off root zones the 2D LiDAR cannot see. Rounded joins (8 quadrant
  2013	  // segments) avoid miter spikes on concave operator polygons.
  2014	  OGRLinearRing ogr_ring;
  2015	  for (std::size_t i = 0; i < in.size(); ++i)
  2016	  {
  2017	    const auto p = in.getGeometry(i);
  2018	    ogr_ring.addPoint(p.getX(), p.getY());
  2019	  }
  2020	  ogr_ring.closeRings();
  2021	  OGRPolygon poly;
  2022	  poly.addRing(&ogr_ring);
  2023	  std::unique_ptr<OGRGeometry> grown(poly.Buffer(margin, 8));
  2024	  // Buffer degeneracies (self-intersecting input, collapsed area) fall back
  2025	  // to the raw ring — the planner still avoids the drawn polygon itself,
  2026	  // just without the extra margin. Never drop the obstacle.
  2027	  if (!grown)
  2028	  {
  2029	    return dedupClosedRing(in);
  2030	  }
  2031	  const OGRPolygon* grown_poly = nullptr;
  2032	  const auto flat_type = wkbFlatten(grown->getGeometryType());
  2033	  if (flat_type == wkbPolygon)
  2034	  {
  2035	    grown_poly = grown->toPolygon();
  2036	  }
  2037	  else if (flat_type == wkbMultiPolygon)
  2038	  {
  2039	    // Outward buffering can merge lobes of a degenerate ring into several
  2040	    // parts; keep the largest (the obstacle body).
  2041	    double best_area = -1.0;
  2042	    for (const auto* part : *grown->toMultiPolygon())
  2043	    {
  2044	      const double a = part->get_Area();
  2045	      if (a > best_area)
  2046	      {
  2047	        best_area = a;
  2048	        grown_poly = part;
  2049	      }
  2050	    }
  2051	  }
  2052	  if (!grown_poly || !grown_poly->getExteriorRing() ||
  2053	      grown_poly->getExteriorRing()->getNumPoints() < 4)
  2054	  {
  2055	    return dedupClosedRing(in);
  2056	  }
  2057	  const OGRLinearRing* ext = grown_poly->getExteriorRing();
  2058	  f2c::types::LinearRing out;
  2059	  for (int i = 0; i < ext->getNumPoints(); ++i)
  2060	  {
  2061	    out.addPoint(f2c::types::Point(ext->getX(i), ext->getY(i)));
  2062	  }
  2063	  return dedupClosedRing(out);
  2064	}
