  1692	  // Heading at a polyline's start (p[0]→p[1]) and end (p[n-2]→p[n-1]).
  1693	  auto entryHeading = [](const std::vector<std::pair<double, double>>& s)
  1694	  {
  1695	    return std::atan2(s[1].second - s[0].second, s[1].first - s[0].first);
  1696	  };
  1697	  auto exitHeading = [](const std::vector<std::pair<double, double>>& s)
  1698	  {
  1699	    const std::size_t n = s.size();
  1700	    return std::atan2(s[n - 1].second - s[n - 2].second, s[n - 1].first - s[n - 2].first);
