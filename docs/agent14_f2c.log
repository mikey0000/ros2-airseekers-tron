  2140	
  2141	f2c::types::LinearRing dedupClosedRing(const f2c::types::LinearRing& in)
  2142	{
  2143	  // 1. Metric dedup: drop any vertex within kRingDedupTolM of the previous kept
  2144	  // vertex. A 1e-9 (nanometre) tolerance let mm-scale near-duplicates through —
  2145	  // boost accepts the points but F2C's headland offset / swath clip then drop
  2146	  // whole swaths. 1 cm is well below op_width, so real corners are preserved.
  2147	  std::vector<f2c::types::Point> pts;
  2148	  for (std::size_t i = 0; i < in.size(); ++i)
  2149	  {
  2150	    const auto p = in.getGeometry(i);
  2151	    if (!pts.empty() &&
  2152	        std::hypot(p.getX() - pts.back().getX(), p.getY() - pts.back().getY()) < kRingDedupTolM)
  2153	    {
  2154	      continue;  // near-zero-length edge — boost/F2C would reject or mis-clip it
  2155	    }
  2156	    pts.push_back(f2c::types::Point(p.getX(), p.getY()));
  2157	  }
  2158	  // Drop a near-duplicate closing vertex (the 1.2 mm seam) so the open vertex
  2159	  // list carries no first≈last pair; the ring is re-closed explicitly below.
  2160	  while (pts.size() >= 2 && std::hypot(pts.front().getX() - pts.back().getX(),
  2161	                                       pts.front().getY() - pts.back().getY()) < kRingDedupTolM)
  2162	  {
  2163	    pts.pop_back();
  2164	  }
  2165	
  2166	  // 2. Spike / near-collinear removal: drop any vertex whose perpendicular
  2167	  // distance to the chord between its PREVIOUS KEPT vertex and its next neighbour
  2168	  // is below kRingSpikeTolM. This clears both exactly-collinear points and
  2169	  // mm-scale hooks (a 1 mm needle is invalid to boost even when each of its edges
  2170	  // exceeds kRingDedupTolM). Chaining off the last kept vertex (rather than the
  2171	  // raw predecessor) bounds the total deviation along a genuine curve to
  2172	  // kRingSpikeTolM, so a rounded corner from an OGR buffer is simplified — not
  2173	  // collapsed to a chamfer. Single deterministic pass (resume-by-index depends
  2174	  // on the plan being reproducible).
  2175	  if (pts.size() >= 4)
  2176	  {
  2177	    std::vector<f2c::types::Point> kept;
  2178	    const std::size_t n = pts.size();
  2179	    for (std::size_t i = 0; i < n; ++i)
  2180	    {
  2181	      const f2c::types::Point& a = kept.empty() ? pts[n - 1] : kept.back();
  2182	      const f2c::types::Point& b = pts[i];
  2183	      const f2c::types::Point& c = pts[(i + 1) % n];
  2184	      const double dx = c.getX() - a.getX();
  2185	      const double dy = c.getY() - a.getY();
  2186	      const double len2 = dx * dx + dy * dy;
  2187	      const double cross = dx * (a.getY() - b.getY()) - dy * (a.getX() - b.getX());
  2188	      double perp = std::hypot(b.getX() - a.getX(), b.getY() - a.getY());
  2189	      if (len2 > 0.0)
  2190	      {
  2191	        perp = std::fabs(cross) / std::sqrt(len2);
  2192	      }
  2193	      if (perp >= kRingSpikeTolM)
  2194	      {
  2195	        kept.push_back(b);
  2196	      }
  2197	    }
  2198	    if (kept.size() >= 3)  // never collapse the field below a triangle
  2199	    {
  2200	      pts = kept;
  2201	    }
  2202	  }
  2203	
  2204	  // Re-close the ring (F2C wants first == last).
  2205	  f2c::types::LinearRing out;
  2206	  for (const auto& p : pts)
  2207	  {
  2208	    out.addPoint(p);
  2209	  }
  2210	  if (pts.size() >= 2)
  2211	  {
  2212	    out.addPoint(f2c::types::Point(pts.front().getX(), pts.front().getY()));
  2213	  }
  2214	
  2215	  // 3. OGR validity repair: even after the metric/spike passes a ring can retain
  2216	  // a self-touch boost::geometry rejects. makeRingValid returns the boost-valid
  2217	  // equivalent, or the deduped ring unchanged if the repair degenerates.
  2218	  return makeRingValid(out);
  2219	}
