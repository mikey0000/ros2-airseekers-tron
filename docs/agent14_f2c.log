  1611	  // blade-on join PER COLUMN through/around the bite (user report: "the plan
  1612	  // lands in the middle at the rounded parts"). Greedy nearest-endpoint chaining
  1613	  // is identical to the plain serpentine on a convex field (the nearest unvisited
  1614	  // piece IS the adjacent swath, entered at the near end), but on a split field
  1615	  // it mows each lobe contiguously and leaves ONE long hop per lobe change —
  1616	  // which the join-gap split below turns into a single blade-off Nav2 transit.
  1617	  // Deterministic for a fixed plan (greedy from a fixed seed). O(n²), n = a few
  1618	  // hundred swaths at most.
  1619	  std::vector<std::pair<std::pair<double, double>, std::pair<double, double>>> ordered_swaths;
  1620	  {
  1621	    const auto& sw_in = plan.swaths;
  1622	    std::vector<bool> used(sw_in.size(), false);
  1623	    // Seed from BoustrophedonOrder's OWN first swath, NOT from the last ring's
  1624	    // end. Seeding from the ring end couples the serpentine direction to where
  1625	    // the ring closure happens to sit (the mid-longest-edge rotation above moved
  1626	    // it), and a flipped serpentine relocates every U-turn to the opposite swath
  1627	    // ends — where the turn-around teardrop may no longer fit inside the safety
  1628	    // inset (measured on the recorded garden: 7 extra cusp-splits from bottom-
  1629	    // edge U-turns that no longer had headland room). BoustrophedonOrder's own
  1630	    // start reproduces the field-proven serpentine regardless of ring layout;
  1631	    // the ring→first-swath hop is then joined blade-on when short or bridged by
  1632	    // one Nav2 transit when long.
  1633	    std::pair<double, double> cur =
  1634	        !sw_in.empty() ? sw_in.front().first : std::pair<double, double>{0.0, 0.0};
  1635	    ordered_swaths.reserve(sw_in.size());
  1636	    for (std::size_t n = 0; n < sw_in.size(); ++n)
  1637	    {
  1638	      std::size_t best = sw_in.size();
  1639	      bool flip = false;
  1640	      double best_d = std::numeric_limits<double>::max();
  1641	      for (std::size_t i = 0; i < sw_in.size(); ++i)
  1642	      {
  1643	        if (used[i])
  1644	        {
  1645	          continue;
  1646	        }
  1647	        const double d0 =
  1648	            std::hypot(sw_in[i].first.first - cur.first, sw_in[i].first.second - cur.second);
  1649	        const double d1 =
  1650	            std::hypot(sw_in[i].second.first - cur.first, sw_in[i].second.second - cur.second);
  1651	        if (d0 < best_d)
  1652	        {
  1653	          best_d = d0;
  1654	          best = i;
  1655	          flip = false;
  1656	        }
  1657	        if (d1 < best_d)
  1658	        {
  1659	          best_d = d1;
  1660	          best = i;
  1661	          flip = true;
  1662	        }
  1663	      }
  1664	      used[best] = true;
  1665	      auto sw = sw_in[best];
  1666	      if (flip)
  1667	      {
  1668	        std::swap(sw.first, sw.second);
  1669	      }
