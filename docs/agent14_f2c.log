  1507	  if (!plan.swaths.empty())
  1508	  {
  1509	    const double probe_x =
  1510	        0.5 * (plan.swaths.front().first.first + plan.swaths.front().second.first);
  1511	    const double probe_y =
  1512	        0.5 * (plan.swaths.front().first.second + plan.swaths.front().second.second);
