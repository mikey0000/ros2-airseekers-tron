  1748	            start, goal, conn_boundary, plan.safe_holes, turn_radius, min_radius, step, fallback);
  1749	        conn_safe = !conn.empty() && (!fallback || (allInside(conn, conn_boundary) &&
  1750	                                                    clearOfHoles(conn, plan.safe_holes) &&
  1751	                                                    straightFallbackIsContinuous(start, goal)));
