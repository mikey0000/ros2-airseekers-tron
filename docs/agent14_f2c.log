  2099	  poly.addRing(&ogr_ring);
  2100	  std::unique_ptr<OGRGeometry> fixed(poly.Buffer(0.0));
  2101	  if (!fixed)
  2102	  {
  2103	    return in;
  2104	  }
  2105	  const OGRPolygon* fixed_poly = nullptr;
  2106	  const auto flat_type = wkbFlatten(fixed->getGeometryType());
  2107	  if (flat_type == wkbPolygon)
  2108	  {
  2109	    fixed_poly = fixed->toPolygon();
  2110	  }
  2111	  else if (flat_type == wkbMultiPolygon)
  2112	  {
  2113	    // Repair can split a bow-tie ring into several parts; keep the field body.
  2114	    double best_area = -1.0;
  2115	    for (const auto* part : *fixed->toMultiPolygon())
  2116	    {
  2117	      const double a = part->get_Area();
  2118	      if (a > best_area)
  2119	      {
  2120	        best_area = a;
  2121	        fixed_poly = part;
  2122	      }
  2123	    }
  2124	  }
  2125	  if (!fixed_poly || !fixed_poly->getExteriorRing() ||
  2126	      fixed_poly->getExteriorRing()->getNumPoints() < 4)
  2127	  {
  2128	    return in;
  2129	  }
