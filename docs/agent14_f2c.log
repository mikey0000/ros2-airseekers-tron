  1466	}  // namespace
  1467	
  1468	std::vector<std::vector<std::pair<double, double>>> buildContinuousSubPaths(
  1469	    const BoustrophedonPlan& plan,
  1470	    const std::vector<std::pair<double, double>>& boundary,
  1471	    double turn_radius,
  1472	    double min_turn_radius,
  1473	    double step,
  1474	    ConnectorStats* stats,
  1475	    const std::vector<std::pair<double, double>>& swath_turn_boundary)
  1476	{
  1477	  // Flatten the plan into ordered drivable segments (densified polylines),
  1478	  // rings first (outermost → inner) then the swaths.
  1479	  //
  1480	  // Ring start alignment (field report 2026-07: "the robot stalls after every
  1481	  // headland ring, oscillating, before moving on"). F2C starts every concentric
  1482	  // ring at the same polygon corner, so the loop CLOSURE sits on that corner and
  1483	  // the ring→ring junction demanded a 45–90° heading change across a ~op_width
  1484	  // gap — no trackable Dubins fits, the join degenerates to a near-cusp, and FTC
  1485	  // fights the drivetrain deadband pivoting through it (the observed stall +
  1486	  // wz oscillation). Rotate each ring loop (they are CLOSED polylines, any
  1487	  // vertex is a valid start) so it begins at the vertex nearest the previous
  1488	  // ring's end: concentric rings are locally parallel there, so the junction
  1489	  // becomes a gentle ~op_width sideways shift the connector joins tangentially.
  1490	  // The first ring keeps F2C's start (TransitToStrip already targets it).
  1491	  // Ring DRIVE-ORDER grouping. F2C's generateHeadlandSwaths emits ring loops PER
  1492	  // PASS as [outer, hole, outer, hole, …], so consecutive concentric OUTER rings
  1493	  // are interleaved with the field-centre hole rings. Driven in that raw order the
  1494	  // path jumps outer-ring → hole-ring → outer-ring every pass, and each jump is a
  1495	  // field-crossing relocation the join-gap split below (Split A) turns into a
  1496	  // spurious blade-off Nav2 transit (3–4 extra transits, purely an ordering
  1497	  // artifact). Partition into outer-boundary rings FIRST (outermost-first order
  1498	  // preserved) then the obstacle-encircling rings, so each group drives
  1499	  // contiguously and only ONE relocation separates the two. A ring is an OUTER
  1500	  // ring iff it encloses a MAINLAND point (a swath endpoint): the mainland lies
  1501	  // inside every nested outer ring and outside every small hole ring. Falls back
  1502	  // to the raw order when there are no swaths (rings-only field: no mainland probe,
  1503	  // and a fully-consumed field rarely carries hole rings worth reordering). Ring
  1504	  // GEOMETRY is untouched — only the order the loops are appended.
