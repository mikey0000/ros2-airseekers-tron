  1576	            {
  1577	              continue;  // outgoing heading not parallel to the previous exit
  1578	            }
  1579	          }
  1580	          const double dx = loop[j].first - prev_end.first;
  1581	          const double dy = loop[j].second - prev_end.second;
  1582	          const double d2 = dx * dx + dy * dy;
