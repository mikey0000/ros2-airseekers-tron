  1839	    if (boundary.size() >= 3)
  1840	    {
  1841	      for (auto& pt : rounded)
  1842	      {
  1843	        pt = clampInsideRing(pt.first, pt.second, boundary, kClearanceClampMarginM);
  1844	      }
  1845	    }
  1846	    // Connector discontinuities were split before rounding, so every remaining
  1847	    // join in this sub-path is either part of an original segment or tangent to a
  1848	    // real connector arc.
  1849	    if (rounded.size() >= 2)
  1850	    {
  1851	      out.emplace_back(std::move(rounded));
  1852	    }
  1853	  }
  1854	
  1855	  // Sub-path DRIVE ORDER: minimize the blade-off Nav2 transit BETWEEN sub-paths.
  1856	  // The sub-paths above come out in swath-chain order; on a multi-hole field that
  1857	  // leaves the driver criss-crossing the lawn between lobes (measured 77 m of
  1858	  // blade-off transit on the recorded 4-hole garden). Greedy nearest-neighbour
  1859	  // over the FINISHED sub-path polylines, entering each at whichever end is
  1860	  // nearer, mows spatially adjacent lobes consecutively (77 → 47 m there).
  1861	  //   * Reversing a FINISHED polyline is safe: the points are identical, so every
  1862	  //     turn-around / fillet stays exactly as in-bounds and trackable as before —
  1863	  //     only reversing the swath ORDER *before* the path is built relocates
  1864	  //     U-turns (the hazard the seed-from-BoustrophedonOrder note above guards);
  1865	  //     driving the same polyline backwards moves nothing.
  1866	  //   * Sub-path 0 stays the seed — TransitToStrip already drives the robot to
  1867	  //     its start, and the BT resumes by sub-path index (deterministic: a fixed
  1868	  //     plan yields a fixed NN order, so indices are stable across re-plans).
  1869	  //   * Adopt the NN order ONLY when it actually shortens the transit, so a field
  1870	  //     the chain order already sequenced well can never regress.
  1871	  if (out.size() > 1)
  1872	  {
  1873	    auto gap = [](const std::pair<double, double>& a, const std::pair<double, double>& b)
  1874	    {
  1875	      return std::hypot(a.first - b.first, a.second - b.second);
  1876	    };
  1877	    double chain_transit = 0.0;
  1878	    for (std::size_t i = 1; i < out.size(); ++i)
  1879	    {
  1880	      chain_transit += gap(out[i - 1].back(), out[i].front());
  1881	    }
  1882	    std::vector<std::size_t> order{0};
  1883	    std::vector<bool> reversed_flag(out.size(), false);
  1884	    std::vector<bool> used(out.size(), false);
  1885	    used[0] = true;
  1886	    std::pair<double, double> cur = out[0].back();
  1887	    double nn_transit = 0.0;
  1888	    for (std::size_t n = 1; n < out.size(); ++n)
  1889	    {
  1890	      std::size_t best = 0;
  1891	      bool best_rev = false;
  1892	      double best_d = std::numeric_limits<double>::max();
  1893	      for (std::size_t j = 0; j < out.size(); ++j)
  1894	      {
  1895	        if (used[j])
  1896	        {
  1897	          continue;
  1898	        }
  1899	        const double ds = gap(cur, out[j].front());  // enter forward
  1900	        const double de = gap(cur, out[j].back());  // enter reversed
  1901	        if (ds < best_d)
  1902	        {
  1903	          best_d = ds;
  1904	          best = j;
  1905	          best_rev = false;
  1906	        }
  1907	        if (de < best_d)
  1908	        {
  1909	          best_d = de;
  1910	          best = j;
  1911	          best_rev = true;
  1912	        }
  1913	      }
  1914	      used[best] = true;
  1915	      reversed_flag[best] = best_rev;
  1916	      order.push_back(best);
  1917	      nn_transit += best_d;
  1918	      cur = best_rev ? out[best].front() : out[best].back();
  1919	    }
  1920	    if (nn_transit + 1e-6 < chain_transit)
  1921	    {
  1922	      std::vector<std::vector<std::pair<double, double>>> reordered;
  1923	      reordered.reserve(out.size());
  1924	      for (const std::size_t idx : order)
  1925	      {
  1926	        std::vector<std::pair<double, double>> sp = std::move(out[idx]);
  1927	        if (reversed_flag[idx])
  1928	        {
  1929	          std::reverse(sp.begin(), sp.end());
  1930	        }
  1931	        reordered.push_back(std::move(sp));
  1932	      }
  1933	      out = std::move(reordered);
  1934	    }
  1935	  }
  1936	  return out;
  1937	}
  1938	
  1939	std::vector<std::pair<double, double>> buildContinuousPath(
  1940	    const BoustrophedonPlan& plan,
  1941	    const std::vector<std::pair<double, double>>& boundary,
  1942	    double turn_radius,
  1943	    double min_turn_radius,
  1944	    double step)
  1945	{
  1946	  // Concatenate the drivable sub-paths into one visualisation polyline. The
  1947	  // driver uses buildContinuousSubPaths directly so every boundary becomes a
  1948	  // blade-off Nav2 transit rather than a driven discontinuity.
  1949	  const auto subs = buildContinuousSubPaths(plan, boundary, turn_radius, min_turn_radius, step);
  1950	  std::vector<std::pair<double, double>> path;
  1951	  for (const auto& sp : subs)
  1952	  {
  1953	    path.insert(path.end(), sp.begin(), sp.end());
  1954	  }
  1955	  return path;
  1956	}
