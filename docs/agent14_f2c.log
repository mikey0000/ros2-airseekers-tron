    {
        int path_space = 3;// 路径间距

        std::vector<bool> along_orders;                         // 外层沿边顺序
        std::vector<bool> forbidden_orders;                     // 禁区沿边顺序
        std::vector<cv::Point> forbidden_centroids;             // 禁区质心 
        std::vector<std::vector<cv::Point>> forbidden_contours; // 禁区轮廓
    };

    struct SetCoverParameter
    {
        int path_space = 3;// 路径间距
        int path_type = 1; // 路径类型：（1：回字形，2：工字形）
    };

    struct AlongBorder{
        cv::Mat initial_image;           // 原始图像
