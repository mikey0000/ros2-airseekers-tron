  1563	      double best_d2 = std::numeric_limits<double>::max();
  1564	      bool found_aligned = false;
  1565	      for (int pass = 0; pass < 2 && !found_aligned; ++pass)
  1566	      {
  1567	        for (std::size_t j = 0; j < loop.size(); ++j)
  1568	        {
  1569	          if (pass == 0 && en > 1e-9)
  1570	          {
  1571	            const auto& nxt = loop[(j + 1) % loop.size()];
