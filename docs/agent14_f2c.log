  1410	// path only nudges the out-of-bounds convex-corner pokes and is a no-op for every
  1411	// ring/swath/connector pose the planner already kept in-bounds.
  1412	std::pair<double, double> clampInsideRing(double x,
  1413	                                          double y,
  1414	                                          const std::vector<std::pair<double, double>>& ring,
  1415	                                          double margin)
  1416	{
  1417	  // A pose sitting exactly ON the ring is left alone: with the headland stage
  1418	  // off the swath ENDS lie on this ring by construction, and pointInRing()
  1419	  // resolves such poses inconsistently — clamping them would silently deform
  1420	  // half the swath ends inward. Same tolerance allInside() uses (kOnEdgeTolM).
  1421	  if (ring.size() < 3 || pointInRing(x, y, ring) || distanceToRing(x, y, ring) <= kOnEdgeTolM)
  1422	  {
  1423	    return {x, y};
  1424	  }
  1425	  // Nearest point on the ring boundary.
  1426	  const std::size_t n = ring.size();
  1427	  double best_d2 = std::numeric_limits<double>::max();
  1428	  double px = x, py = y;
  1429	  for (std::size_t i = 0, j = n - 1; i < n; j = i++)
  1430	  {
  1431	    const double ax = ring[j].first, ay = ring[j].second;
  1432	    const double bx = ring[i].first, by = ring[i].second;
  1433	    const double dx = bx - ax, dy = by - ay;
  1434	    const double len2 = dx * dx + dy * dy;
  1435	    double t = (len2 > 0.0) ? ((x - ax) * dx + (y - ay) * dy) / len2 : 0.0;
  1436	    t = std::max(0.0, std::min(1.0, t));
  1437	    const double qx = ax + t * dx, qy = ay + t * dy;
  1438	    const double d2 = (x - qx) * (x - qx) + (y - qy) * (y - qy);
  1439	    if (d2 < best_d2)
  1440	    {
  1441	      best_d2 = d2;
  1442	      px = qx;
  1443	      py = qy;
  1444	    }
  1445	  }
  1446	  // The direction from the exterior pose toward its nearest boundary projection
  1447	  // points INTO the polygon; stepping `margin` past the projection lands inside
  1448	  // (unless the ring is thinner than the margin there, in which case snap to the
  1449	  // boundary rather than risk crossing to the far side).
  1450	  double inx = px - x, iny = py - y;
  1451	  const double inl = std::hypot(inx, iny);
  1452	  if (inl < 1e-9)
  1453	  {
  1454	    return {px, py};
  1455	  }
  1456	  inx /= inl;
  1457	  iny /= inl;
  1458	  const double cx = px + margin * inx, cy = py + margin * iny;
  1459	  if (pointInRing(cx, cy, ring))
  1460	  {
  1461	    return {cx, cy};
  1462	  }
  1463	  return {px, py};
  1464	}
