  1678	        sw.first.first, sw.first.second, sw.second.first, sw.second.second, step, pts);
  1679	    pts.emplace_back(sw.second.first, sw.second.second);  // include the end
  1680	    if (pts.size() >= 2)
  1681	    {
  1682	      segs.push_back(std::move(pts));
  1683	    }
  1684	  }
