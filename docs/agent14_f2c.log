        std::vector<nav_msgs::Path> erode_ones_paths_public;  // 腐蚀一次后的图像轮廓(处理后)
        std::vector<nav_msgs::Path> erode_twice_paths_public; // 腐蚀两次后的图像轮廓(处理后)

        std::vector<nav_msgs::Path> barrier_initial_paths;           // 障碍物原始图像轮廓
