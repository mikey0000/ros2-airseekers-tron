// pid_controller_ros_node.cpp — standalone PID rotate node.
//
// In the original system `pid_controller_ros_node` drove docking/undocking motion
// (rotate/stop). The reusable primitive (`PidControllerROS`) is consumed in-process by
// the bumper controller; NAV2 docking (opennav_docking) supersedes the high-level
// docking state machine. This node keeps a minimal standalone entry point around the
// library so the rotate primitive stays independently runnable and tunable.
#include <memory>

#include "rclcpp/rclcpp.hpp"
#include "pid_controller/pid_controller_ros.h"

class PidControllerRosNode : public rclcpp::Node {
public:
    PidControllerRosNode() : Node("pid_controller_ros_node"), ctrl_(*this) {
        using namespace std::chrono_literals;
        // Service the PID loop; rotate()/stop() are driven by the caller (bumper
        // controller / docking) through the library API.
        timer_ = create_wall_timer(10ms, [this]() { ctrl_.spinOnce(); });
        RCLCPP_INFO(get_logger(), "pid_controller_ros_node up (rotate/stop primitive)");
    }

private:
    mower_controller::PidControllerROS ctrl_;
    rclcpp::TimerBase::SharedPtr timer_;
};

int main(int argc, char** argv) {
    rclcpp::init(argc, argv);
    rclcpp::spin(std::make_shared<PidControllerRosNode>());
