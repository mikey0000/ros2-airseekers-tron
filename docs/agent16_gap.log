// Map the MCU `MotorStatus.status` (uint8 error enum: 0 normal, 1 overcurrent,
// 2 overvoltage, 3 undervoltage, 4 overheat, 5 stalled) onto the ROS
// `mower_msgs/MotorStatus` (0 IDLE, 1 RUNNING, 2 LOCKING, -1..-7 errors).
//
// ASSUMPTION (flagged in handoff as not fully pinned): a normal motor that still
// reports non-zero speed is RUNNING; a normal stopped motor is IDLE. Error codes
// map 1:1 onto the ERROR_* constants. Adjust here if the real unit semantics
// differ — this is the single point of truth for that mapping.
int8_t mapMotorStatus(uint8_t raw, int16_t speed_rpm) {
    switch (raw) {
        case 0:  return (speed_rpm != 0) ? 1 /* RUNNING */ : 0 /* IDLE */;
        case 1:  return mower_msgs::msg::MotorStatus::ERROR_OVERCURRENT;
        case 2:  return mower_msgs::msg::MotorStatus::ERROR_OVERVOLTAGE;
        case 3:  return mower_msgs::msg::MotorStatus::ERROR_UNDERVOLTAGE;
