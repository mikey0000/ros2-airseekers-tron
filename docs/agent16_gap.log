// odometry.cpp — differential-drive pose integration.
#include "mower_base/odometry.h"

#include <cmath>

namespace mower_base {

void MowerOdom::update(double v, double w, double dt) {
    const double theta_mid = pose_.theta + 0.5 * w * dt;
    pose_.x     += v * std::cos(theta_mid) * dt;
    pose_.y     += v * std::sin(theta_mid) * dt;
    pose_.theta += w * dt;
}

}  // namespace mower_base
