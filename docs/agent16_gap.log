namespace mower_sdk {

using protocol::SOF;
using protocol::EOF_;
using protocol::ESCAPE;

Protocol::Protocol(std::shared_ptr<SerialDevice> dev) : dev_(std::move(dev)) {}
Protocol::~Protocol() {}

// ---------------------------------------------------------------------------
// Framing helpers
// ---------------------------------------------------------------------------

uint8_t Protocol::CalculateChecksum(const std::vector<uint8_t>& data) {
    uint32_t sum = 0;
    for (uint8_t b : data) sum += b;
    return static_cast<uint8_t>(sum & 0xFF);
}

std::vector<uint8_t> Protocol::EscapeData(const std::vector<uint8_t>& data) {
    std::vector<uint8_t> out;
    out.reserve(data.size() + data.size() / 4 + 2);
    for (uint8_t b : data) {
        switch (b) {
            case SOF:    out.push_back(ESCAPE); out.push_back(protocol::ESCAPE_SOF); break;
