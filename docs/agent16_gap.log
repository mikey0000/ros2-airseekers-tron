#!/usr/bin/env python3
import os

script_dir = os.path.dirname(os.path.realpath(__file__))

# 获取环境变量中的HOSTNAME
hostname = os.getenv('HOSTNAME')

# 构造URDF文件名
hostname_urdf = os.path.join(script_dir, f"{hostname}.urdf")
mower_urdf = os.path.join(script_dir, "mower.urdf")

# 检查hostname_urdf文件是否存在
if os.path.exists(hostname_urdf):
    urdf_file = hostname_urdf
else:
    urdf_file = mower_urdf

# 读取并输出URDF文件内容
try:
    with open(urdf_file, 'r') as file:
        content = file.read()
        print(content)
except FileNotFoundError:
